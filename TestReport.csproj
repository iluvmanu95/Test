    <PackageReference Include="BoldReports.Net.Core" Version="14.1.19" />
    <PackageReference Include="FastReport.Core.Skia.Demo" Version="2026.2.7" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
